# --- Database ---
# SQLite default — zero setup. For Postgres, set provider="postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Used to sign admin JWT cookies. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Seeded admin login (used by prisma/seed.js)
ADMIN_EMAIL="admin@sportdepot.local"
ADMIN_PASSWORD="admin1234"

# --- Uploads ---
# "local" stores files in public/uploads. "cloudinary" uses Cloudinary.
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
