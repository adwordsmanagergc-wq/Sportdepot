# --- Database ---
# Required: a PostgreSQL connection string.
# Local dev examples:
#   - Docker:   postgresql://postgres:postgres@localhost:5432/sportdepot
#   - Neon:     postgresql://user:pass@ep-xxx.aws.neon.tech/sportdepot?sslmode=require
#   - Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportdepot"

# --- Auth ---
# Used to sign admin JWT cookies. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Seeded admin login (used by prisma/seed.js)
ADMIN_EMAIL="admin@sportdepot.local"
ADMIN_PASSWORD="admin1234"

# --- Uploads ---
# "local" stores files in public/uploads. "cloudinary" uses Cloudinary.
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
